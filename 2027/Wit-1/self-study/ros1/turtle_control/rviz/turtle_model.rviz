Panels:
  - Class: rviz/Displays
    Name: Displays
  - Class: rviz/Views
    Name: Views
Visualization Manager:
  Class: ""
  Global Options:
    Fixed Frame: turtle_world
    Background Color: 40; 40; 40
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Reference Frame: turtle_world
      Plane: XY
      Plane Cell Count: 20
      Cell Size: 1
      Alpha: 0.4
      Color: 160; 160; 160
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
      Robot Description: robot_description
      Visual Enabled: true
      Collision Enabled: false
      Alpha: 1
    - Class: rviz/TF
      Name: TF
      Enabled: true
      Show Names: true
      Show Axes: true
      Show Arrows: false
      Marker Scale: 2
      Frames:
        All Enabled: false
        turtle_world:
          Value: true
        turtle_body:
          Value: true
        camera_link:
          Value: true
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/Select
  Views:
    Current:
      Class: rviz/Orbit
      Name: Current View
      Target Frame: turtle_world
      Distance: 3
      Focal Point:
        X: 5
        Y: 5
        Z: 0.15
      Pitch: 0.6
      Yaw: 0.8
Window Geometry:
  Width: 1100
  Height: 760
